# 复制本文件为 .env 并按需修改

# ---- Django ----
# 上线前务必改成随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-long-string
# 调试模式：本地开发 True；正式对外建议 False
DJANGO_DEBUG=True
# 允许访问的域名/IP，逗号分隔。内网穿透时填你的公网域名，如 mood.example.com
DJANGO_ALLOWED_HOSTS=*
# 通过公网域名提交表单/聊天必须配置，否则 CSRF 403。带 https:// 前缀，逗号分隔
# 例：CSRF_TRUSTED_ORIGINS=https://mood.example.com,http://你的IP:端口
CSRF_TRUSTED_ORIGINS=

# ---- DeepSeek（AI 树洞）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-v4-flash 便宜快，适合聊天；复杂场景可换 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash


# ---- 语音合成（edge-tts，免费，无需任何 key）----
# 一般不用改。想换音色/语速时再设置：
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%
